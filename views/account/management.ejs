<!--views/account/management.ejs-->
<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>
  <body class="checkerboard">
    <div class="page">
      <%- include('../partials/brandbar') %>
      <%- include('../partials/navigation') %>

      <main class="container main-content">
        <h1 class="page-title"><%= title %></h1>

        <% if (typeof messages === 'function') { %>
          <%- messages() %>
        <% } %>

        <% const acct = locals.account; %>

        <% if (!acct) { %>
          <!-- Fallback if someone reaches this view without a JWT -->
          <p>Please <a href="/account/login">log in</a> to view your account.</p>
        <% } else { %>
          <!-- Greet by first name -->
          <h2>Welcome <%= acct.account_firstname %></h2>

          <!-- Update link (visible to ALL) -->
          <p class="mt-2">
            <a href="/account/update/<%= acct.account_id %>">Update account information</a>
          </p>

          <!--Reviews-->
          <h3>Your Reviews</h3>
          <% const rv = Array.isArray(myReviews) ? myReviews : []; %>
          <% if (rv.length) { %>
            <ul class="user-reviews">
              <% rv.forEach(r => { %>
                <li>
                  <div>
                    <strong><%= (r.inv_year || '').toString().trim() %> <%= r.inv_make %> <%= r.inv_model %></strong>
                    <span class="review-date"><%= new Date(r.review_date).toLocaleDateString() %></span>
                  </div>
                  <p><%= r.review_text %></p>
                  <p class="muted">
                    <a href="/reviews/edit/<%= r.review_id %>">Edit</a>
                    |
                    <a href="/reviews/delete/<%= r.review_id %>">Delete</a>
                  </p>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <p>You haven't written any reviews yet.</p>
          <% } %>

          <!-- Admin/Employee-only block -->
          <% if (acct.account_type === 'Employee' || acct.account_type === 'Admin') { %>
            <h3 class="mt-4">Inventory Management</h3>
            <p>
              <a href="/inv/">Go to Inventory Management</a>
            </p>
          <% } %>
        <% } %>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </body>
</html>

