<!-- views/inventory/edit-inventory.ejs -->
<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body class="checkerboard">
  <div class="page">
    <%- include('../partials/brandbar') %>
    <%- include('../partials/navigation') %>

    <main class="container main-content">
      <h1><%= title %></h1>

      <% if (typeof messages === 'function') { %>
        <%- messages() %>
      <% } %>

      <form action="/inv/update" method="post" class="inventory-form">
        <input type="hidden" name="inv_id" value="<%= inv_id %>">

        <div class="form-row">
          <label for="classificationList">Classification</label>
          <%- classificationList %>
        </div>

        <div class="form-row">
          <label for="inv_make">Make</label>
          <input id="inv_make" name="inv_make" type="text" required value="<%= inv_make %>">
        </div>

        <div class="form-row">
          <label for="inv_model">Model</label>
          <input id="inv_model" name="inv_model" type="text" required value="<%= inv_model %>">
        </div>

        <label for="inv_year">Year</label>
          <input id="inv_year" name="inv_year" type="text" pattern="^[0-9]{4}$" required
                 title="4 digit year" value="<%= inv_year || '' %>">

        <div class="form-row">
          <label for="inv_description">Description</label>
          <textarea id="inv_description" name="inv_description" required><%= inv_description %></textarea>
        </div>

        <div class="form-row">
          <label for="inv_image">Image path</label>
          <input id="inv_image" name="inv_image" type="text" required value="<%= inv_image %>">
        </div>

        <div class="form-row">
          <label for="inv_thumbnail">Thumbnail path</label>
          <input id="inv_thumbnail" name="inv_thumbnail" type="text" required value="<%= inv_thumbnail %>">
        </div>

        <div class="form-row">
          <label for="inv_price">Price</label>
          <input id="inv_price" name="inv_price" type="number" min="0" step="0.01" required value="<%= inv_price %>">
        </div>

        <div class="form-row">
          <label for="inv_miles">Miles</label>
          <input id="inv_miles" name="inv_miles" type="number" min="0" step="1" required value="<%= inv_miles %>">
        </div>

        <div class="form-row">
          <label for="inv_color">Color</label>
          <input id="inv_color" name="inv_color" type="text" required value="<%= inv_color %>">
        </div>

        <button type="submit" class="btn-primary">Update Vehicle</button>

        <input type="hidden" name="inv_id"
        <% if(locals.inv_id) { %> value="<%= locals.inv_id %>"
        <% } %>>
      </form>
    </main>

    <%- include('../partials/footer') %>
  </div>
</body>
</html>
