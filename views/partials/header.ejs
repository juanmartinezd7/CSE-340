<!-- views/partials/header.ejs -->
<header class="app-header">
  <div class="container topbar">
    <h1 class="brand">CSE Motors</h1>

    <div class="auth-links">
      <% if (account) { %>
        <!-- Visible only when logged in -->
        <span class="welcome-link">
          Welcome <a href="/account"><%= account.account_firstname %></a>
        </span>

        <!-- Use POST for logout -->
        <form action="/account/logout" method="post" class="logout-form">
          <button type="submit" class="account logout-btn">Logout</button>
        </form>
      <% } else { %>
        <!-- Visible only when logged out -->
        <a class="account" href="/account/login">My Account</a>
      <% } %>
    </div>
  </div>

  <%- include('./navigation') %>

  <!-- Hero -->
  <div class="container hero">
    <h2 class="welcome">Welcome to CSE Motors!</h2>
    <div class="hero-stage">
      <img class="hero-car" src="/images/vehicles/delorean.jpg" alt="DMC Delorean" />
      <div class="hero-card">
        <h3 class="car-name">DMC Delorean</h3>
        <ul class="car-features">
          <li>3 Cup holders</li>
          <li>Superman doors</li>
          <li>Fuzzy dice</li>
        </ul>
        <a href="#" class="btn-primary">Own Today</a>
      </div>
    </div>
  </div>
</header>




